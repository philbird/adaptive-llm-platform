            "default": 0,
            "minimum": 0.0,
            "title": "Seed",
            "type": "integer"
          },
          "source_window": {
            "$ref": "#/components/schemas/SourceWindow"
          },
          "split_strategy": {
            "const": "subject_and_document_family",
            "default": "subject_and_document_family",
            "title": "Split Strategy",
            "type": "string"
          },
          "target_preference_order": {
            "items": {
              "enum": [
                "correction",
                "positive_resolution",
                "production_output"
              ],
              "type": "string"
            },
            "maxItems": 3,
            "minItems": 1,
            "title": "Target Preference Order",
            "type": "array"
          },
          "tenant_ids": {
            "items": {
              "maxLength": 100,
              "minLength": 1,
              "pattern": "^[\\w.-]+$",
              "type": "string"
            },
            "maxItems": 100,
            "minItems": 1,
            "title": "Tenant Ids",
            "type": "array"
          },
          "time_split": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/TimeSplit"
              },
              {
                "type": "null"
              }
            ]
