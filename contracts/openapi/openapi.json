      "DatasetSpecification": {
        "properties": {
          "dataset_id": {
            "maxLength": 100,
            "minLength": 1,
            "pattern": "^[\\w.-]+$",
            "title": "Dataset Id",
            "type": "string"
          },
          "eligibility_policy_version": {
            "maxLength": 100,
            "minLength": 1,
            "pattern": "^[\\w.-]+$",
            "title": "Eligibility Policy Version",
            "type": "string"
          },
          "grouping_keys": {
            "items": {
              "enum": [
                "document_family",
                "subject_id_pseudonymous"
              ],
              "type": "string"
            },
            "title": "Grouping Keys",
            "type": "array"
          },
          "minimum_examples": {
            "default": 1,
            "minimum": 1.0,
            "title": "Minimum Examples",
            "type": "integer"
          },
          "near_duplicate_threshold": {
            "default": 0.8,
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Near Duplicate Threshold",
            "type": "number"
          },
          "purpose": {
            "default": "adapter_training",
            "enum": [
              "adapter_training",
              "distillation",
              "router_training",
              "evaluation"
            ],
            "title": "Purpose",
            "type": "string"
          },
          "schema_version": {
            "const": "1.0",
            "default": "1.0",
            "title": "Schema Version",
            "type": "string"
          },
