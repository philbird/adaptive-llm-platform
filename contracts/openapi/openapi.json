      "InferenceRequest": {
        "additionalProperties": false,
        "description": "Client request.\n\n`request_id` is the idempotency key, scoped to the authenticated tenant and\n`application_id`. A replay within the idempotency window returns the original response\nand marks it as replayed; a replay with a different body is rejected.",
        "properties": {
          "application_id": {
            "maxLength": 100,
            "minLength": 1,
            "pattern": "^[\\w.-]+$",
            "title": "Application Id",
            "type": "string"
          },
          "max_output_tokens": {
            "default": 512,
            "maximum": 2048.0,
            "minimum": 1.0,
            "title": "Max Output Tokens",
            "type": "integer"
          },
          "messages": {
            "items": {
              "$ref": "#/components/schemas/Message"
            },
            "maxItems": 32,
            "minItems": 1,
            "title": "Messages",
            "type": "array"
          },
          "metadata": {
            "maxProperties": 16,
            "patternProperties": {
              "^[\\w.-]+$": {
                "maxLength": 200,
                "type": "string"
              }
            },
            "propertyNames": {
              "maxLength": 100,
              "minLength": 1
            },
            "title": "Metadata",
            "type": "object"
          },
          "rag": {
            "$ref": "#/components/schemas/RagOptions"
          },
          "request_id": {
            "maxLength": 100,
            "minLength": 1,
            "pattern": "^[\\w.-]+$",
            "title": "Request Id",
            "type": "string"
          },
          "response_format": {
            "$ref": "#/components/schemas/ResponseFormat"
          },
          "routing": {
            "$ref": "#/components/schemas/RoutingOptions"
          },
          "schema_version": {
            "const": "1.0",
            "default": "1.0",
            "title": "Schema Version",
            "type": "string"
          },
          "stream": {
            "default": false,
            "title": "Stream",
            "type": "boolean"
          }
        },
        "required": [
          "request_id",
          "messages",
          "application_id"
        ],
        "title": "InferenceRequest",
        "type": "object"
      },
