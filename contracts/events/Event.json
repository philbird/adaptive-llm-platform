{
  "$defs": {
    "Candidate": {
      "properties": {
        "confidence": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Confidence"
        },
        "eligible": {
          "title": "Eligible",
          "type": "boolean"
        },
        "estimated_cost_micros": {
          "title": "Estimated Cost Micros",
          "type": "integer"
        },
        "estimated_latency_ms": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Estimated Latency Ms"
        },
        "model_deployment_id": {
          "title": "Model Deployment Id",
          "type": "string"
        },
        "ood_score": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ood Score"
        },
        "predicted_quality": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Predicted Quality"
        },
        "price_list_version": {
          "title": "Price List Version",
          "type": "string"
        },
        "processing_region": {
          "maxLength": 32,
          "minLength": 1,
          "pattern": "^[a-z0-9-]+$",
          "title": "Processing Region",
          "type": "string"
        },
        "reason_codes": {
          "items": {
            "type": "string"
          },
          "title": "Reason Codes",
          "type": "array"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "model_deployment_id",
        "eligible",
        "processing_region",
        "estimated_cost_micros",
        "price_list_version",
        "reason_codes"
      ],
      "title": "Candidate",
      "type": "object"
    },
    "ChunkEvidence": {
      "properties": {
        "chunk_id": {
          "title": "Chunk Id",
          "type": "string"
        },
        "content_hash": {
          "title": "Content Hash",
          "type": "string"
        },
        "content_ref": {
          "anyOf": [
            {
              "maxLength": 512,
              "minLength": 1,
