          "default": null,
          "title": "Adapter Id"
        },
        "attempt_id": {
          "title": "Attempt Id",
          "type": "string"
        },
        "attempt_number": {
          "default": 1,
          "title": "Attempt Number",
          "type": "integer"
        },
        "deployment_id": {
          "title": "Deployment Id",
          "type": "string"
        },
        "error_code": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Error Code"
        },
        "estimated_cost_micros": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Estimated Cost Micros"
        },
        "finish_reason": {
          "enum": [
            "stop",
            "length",
            "error"
          ],
          "title": "Finish Reason",
          "type": "string"
        },
        "first_token_latency_ms": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "First Token Latency Ms"
        },
        "interaction_id": {
          "title": "Interaction Id",
          "type": "string"
        },
        "model_id": {
          "title": "Model Id",
          "type": "string"
        },
        "model_provider": {
          "title": "Model Provider",
          "type": "string"
        },
        "model_version": {
          "title": "Model Version",
          "type": "string"
        },
        "output_hash": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Output Hash"
        },
        "output_ref": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Output Ref"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "total_latency_ms": {
          "title": "Total Latency Ms",
          "type": "number"
        },
        "usage": {
          "anyOf": [
            {
              "$ref": "#/$defs/Usage"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "validation": {
          "anyOf": [
            {
              "$ref": "#/$defs/Validation"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "interaction_id",
        "model_provider",
        "model_id",
        "model_version",
        "deployment_id",
        "total_latency_ms",
        "finish_reason"
      ],
      "title": "GenerationAttempt",
      "type": "object"
    },
    "Interaction": {
      "additionalProperties": false,
      "properties": {
        "application_id": {
          "title": "Application Id",
          "type": "string"
        },
        "completed_at": {
          "format": "date-time",
          "title": "Completed At",
          "type": "string"
        },
        "environment": {
          "const": "local",
          "default": "local",
          "title": "Environment",
          "type": "string"
        },
        "error_code": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Error Code"
        },
        "final_attempt_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
