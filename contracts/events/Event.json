      "additionalProperties": false,
      "properties": {
        "eligible": {
          "title": "Eligible",
          "type": "boolean"
        },
        "estimated_cost_micros": {
          "title": "Estimated Cost Micros",
          "type": "integer"
        },
        "model_deployment_id": {
          "title": "Model Deployment Id",
          "type": "string"
        },
        "ood_score": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ood Score"
        },
        "predicted_quality": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Predicted Quality"
        },
        "reason_codes": {
          "items": {
            "type": "string"
          },
          "title": "Reason Codes",
          "type": "array"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "model_deployment_id",
        "eligible",
        "estimated_cost_micros",
        "reason_codes"
      ],
      "title": "Candidate",
      "type": "object"
    },
    "ChunkEvidence": {
      "additionalProperties": false,
      "properties": {
        "chunk_id": {
          "title": "Chunk Id",
          "type": "string"
        },
        "content_hash": {
          "title": "Content Hash",
          "type": "string"
        },
        "context_position": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Context Position"
        },
        "document_id": {
          "title": "Document Id",
          "type": "string"
        },
        "document_version": {
          "title": "Document Version",
          "type": "string"
        },
        "licence_class": {
          "title": "Licence Class",
          "type": "string"
        },
        "rank_retrieved": {
          "title": "Rank Retrieved",
          "type": "integer"
        },
        "retrieval_score": {
          "title": "Retrieval Score",
          "type": "number"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "supplied_to_model": {
          "title": "Supplied To Model",
