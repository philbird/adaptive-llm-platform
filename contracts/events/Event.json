            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Content Ref"
        },
        "context_position": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Context Position"
