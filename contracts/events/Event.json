        "document_id": {
          "title": "Document Id",
          "type": "string"
        },
        "document_version": {
          "title": "Document Version",
          "type": "string"
        },
        "licence_class": {
          "title": "Licence Class",
          "type": "string"
        },
        "rank_retrieved": {
          "title": "Rank Retrieved",
          "type": "integer"
        },
        "rerank_score": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rerank Score"
        },
        "retrieval_score": {
          "title": "Retrieval Score",
          "type": "number"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "supplied_to_model": {
          "title": "Supplied To Model",
          "type": "boolean"
        },
        "token_count": {
          "title": "Token Count",
          "type": "integer"
        }
      },
      "required": [
        "document_id",
        "document_version",
        "chunk_id",
        "rank_retrieved",
        "retrieval_score",
        "supplied_to_model",
        "context_position",
        "token_count",
        "content_hash",
        "licence_class"
      ],
      "title": "ChunkEvidence",
      "type": "object"
    },
    "DatasetBuilt": {
      "properties": {
        "approval_status": {
          "default": "pending",
          "enum": [
            "pending",
            "approved",
            "rejected"
          ],
          "title": "Approval Status",
          "type": "string"
        },
        "dataset_id": {
          "maxLength": 100,
          "minLength": 1,
          "pattern": "^[\\w.-]+$",
          "title": "Dataset Id",
          "type": "string"
        },
        "deletions_applied_through": {
          "format": "date-time",
          "title": "Deletions Applied Through",
          "type": "string"
        },
        "manifest_digest": {
          "title": "Manifest Digest",
          "type": "string"
        },
        "purpose": {
          "enum": [
            "adapter_training",
            "distillation",
            "router_training",
            "evaluation"
          ],
          "title": "Purpose",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "version": {
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "dataset_id",
        "version",
        "purpose",
        "manifest_digest",
        "deletions_applied_through"
      ],
      "title": "DatasetBuilt",
      "type": "object"
    },
    "DeletionRequest": {
      "properties": {
        "actor_id_pseudonymous": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Actor Id Pseudonymous"
        },
        "deletion_request_id": {
          "title": "Deletion Request Id",
          "type": "string"
        },
        "requested_at": {
          "format": "date-time",
          "title": "Requested At",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "scope": {
          "enum": [
            "subject",
            "interaction",
            "tenant",
            "document",
            "dataset"
          ],
          "title": "Scope",
          "type": "string"
        },
        "target_id": {
          "title": "Target Id",
          "type": "string"
        }
      },
      "required": [
        "scope",
        "target_id"
      ],
      "title": "DeletionRequest",
      "type": "object"
    },
    "DeploymentChanged": {
      "properties": {
        "actor_id": {
          "title": "Actor Id",
          "type": "string"
        },
        "deployment_id": {
          "title": "Deployment Id",
          "type": "string"
        },
        "evaluation_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Evaluation Id"
        },
        "model_version": {
          "title": "Model Version",
          "type": "string"
        },
        "new_state": {
          "anyOf": [
            {
              "enum": [
                "candidate",
                "evaluating",
                "approved",
                "shadow",
                "canary",
                "production",
                "deprecated",
                "revoked"
              ],
              "type": "string"
            },
            {
              "enum": [
                "active",
                "inactive",
                "enabled",
                "disabled"
              ],
              "type": "string"
            }
          ],
          "title": "New State"
        },
        "previous_state": {
          "anyOf": [
            {
              "enum": [
                "candidate",
                "evaluating",
                "approved",
                "shadow",
                "canary",
                "production",
                "deprecated",
                "revoked"
              ],
              "type": "string"
            },
            {
              "enum": [
                "active",
                "inactive",
                "enabled",
                "disabled"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Previous State"
        },
        "reason": {
          "title": "Reason",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "deployment_id",
        "model_version",
        "previous_state",
        "new_state",
        "actor_id",
        "reason"
      ],
      "title": "DeploymentChanged",
      "type": "object"
    },
    "EvaluationCompleted": {
      "properties": {
        "baseline_version": {
