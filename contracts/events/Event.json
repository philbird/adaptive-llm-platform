          "title": "Model Version",
          "type": "string"
        },
        "passed": {
          "title": "Passed",
          "type": "boolean"
        },
        "report_ref": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Report Ref",
          "type": "string"
