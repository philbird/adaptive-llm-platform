        "generation_attempt_ids": {
          "items": {
            "type": "string"
          },
          "title": "Generation Attempt Ids",
          "type": "array"
        },
        "input_hash": {
          "title": "Input Hash",
          "type": "string"
        },
        "input_ref": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Input Ref"
        },
        "interaction_id": {
          "title": "Interaction Id",
          "type": "string"
        },
        "policy": {
          "$ref": "#/$defs/PolicyDecision"
        },
        "request_id": {
          "title": "Request Id",
          "type": "string"
        },
        "retrieval_run_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Retrieval Run Id"
        },
        "route_decision_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Route Decision Id"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "started_at": {
          "format": "date-time",
          "title": "Started At",
          "type": "string"
        },
        "status": {
          "enum": [
            "completed",
            "failed"
          ],
          "title": "Status",
          "type": "string"
        },
        "subject_id_pseudonymous": {
          "title": "Subject Id Pseudonymous",
          "type": "string"
        },
        "task": {
          "$ref": "#/$defs/Task"
        },
        "tenant_id": {
          "title": "Tenant Id",
          "type": "string"
        },
        "trace_id": {
          "title": "Trace Id",
          "type": "string"
        }
      },
      "required": [
        "interaction_id",
        "trace_id",
        "request_id",
        "tenant_id",
        "subject_id_pseudonymous",
        "application_id",
        "started_at",
        "completed_at",
        "task",
        "policy",
        "input_hash",
        "retrieval_run_id",
        "route_decision_id",
        "generation_attempt_ids",
        "final_attempt_id",
        "status"
      ],
      "title": "Interaction",
      "type": "object"
    },
    "PolicyDecision": {
      "additionalProperties": false,
      "properties": {
        "content_logging_allowed": {
          "default": false,
          "title": "Content Logging Allowed",
          "type": "boolean"
        },
        "evaluation_allowed": {
          "default": false,
          "title": "Evaluation Allowed",
          "type": "boolean"
        },
        "human_review_allowed": {
          "default": false,
          "title": "Human Review Allowed",
          "type": "boolean"
        },
        "policy_version": {
          "title": "Policy Version",
          "type": "string"
        },
        "processing_allowed": {
          "default": true,
          "title": "Processing Allowed",
          "type": "boolean"
        },
        "redaction_counts": {
          "additionalProperties": {
            "type": "integer"
          },
          "title": "Redaction Counts",
          "type": "object"
        },
        "redaction_version": {
          "default": "regex-local-1",
          "title": "Redaction Version",
          "type": "string"
        },
        "residency": {
          "default": "local",
          "title": "Residency",
          "type": "string"
        },
        "retention_seconds": {
          "minimum": 1,
          "title": "Retention Seconds",
          "type": "integer"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "training_allowed": {
          "default": false,
          "title": "Training Allowed",
          "type": "boolean"
        }
      },
      "required": [
        "policy_version",
        "retention_seconds"
      ],
      "title": "PolicyDecision",
      "type": "object"
    },
    "RetrievalRun": {
      "additionalProperties": false,
      "properties": {
        "candidates": {
          "items": {
            "$ref": "#/$defs/ChunkEvidence"
          },
          "title": "Candidates",
          "type": "array"
        },
        "embedding_model": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Embedding Model"
        },
        "index_id": {
          "title": "Index Id",
          "type": "string"
        },
        "index_version": {
          "title": "Index Version",
          "type": "string"
        },
        "interaction_id": {
          "title": "Interaction Id",
          "type": "string"
        },
        "latency_ms": {
          "title": "Latency Ms",
          "type": "number"
        },
        "query_hash": {
          "title": "Query Hash",
          "type": "string"
        },
        "reranker_model": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reranker Model"
        },
        "retrieval_run_id": {
          "title": "Retrieval Run Id",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "interaction_id",
        "index_id",
        "index_version",
        "query_hash",
        "latency_ms",
        "candidates"
      ],
      "title": "RetrievalRun",
      "type": "object"
    },
    "RouteDecision": {
      "additionalProperties": false,
      "properties": {
        "candidates": {
          "items": {
            "$ref": "#/$defs/Candidate"
          },
          "title": "Candidates",
          "type": "array"
        },
        "decision_latency_ms": {
          "title": "Decision Latency Ms",
          "type": "number"
        },
        "fallback_deployment_ids": {
          "items": {
            "type": "string"
          },
          "title": "Fallback Deployment Ids",
          "type": "array"
        },
        "interaction_id": {
          "title": "Interaction Id",
          "type": "string"
        },
        "policy_constraints": {
          "items": {
            "type": "string"
          },
          "title": "Policy Constraints",
          "type": "array"
        },
        "route_decision_id": {
          "title": "Route Decision Id",
          "type": "string"
        },
        "router_version": {
          "default": "foundation-only-1",
          "title": "Router Version",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "selected_model_deployment_id": {
          "title": "Selected Model Deployment Id",
          "type": "string"
        }
      },
      "required": [
        "interaction_id",
        "candidates",
        "selected_model_deployment_id",
        "decision_latency_ms",
        "policy_constraints"
      ],
      "title": "RouteDecision",
      "type": "object"
    },
    "Started": {
      "additionalProperties": false,
      "properties": {
        "application_id": {
          "title": "Application Id",
          "type": "string"
        },
        "interaction_id": {
          "title": "Interaction Id",
          "type": "string"
        },
        "policy_version": {
          "title": "Policy Version",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "interaction_id",
        "application_id",
        "policy_version"
      ],
      "title": "Started",
      "type": "object"
    },
    "Task": {
      "additionalProperties": false,
      "properties": {
        "classifier_version": {
          "default": "rules-1",
          "title": "Classifier Version",
          "type": "string"
        },
        "confidence": {
          "maximum": 1,
          "minimum": 0,
          "title": "Confidence",
          "type": "number"
        },
        "label": {
          "title": "Label",
          "type": "string"
        },
        "language": {
          "default": "en",
          "title": "Language",
          "type": "string"
        },
        "reason_codes": {
          "items": {
            "type": "string"
          },
          "title": "Reason Codes",
          "type": "array"
        },
        "risk_tier": {
          "default": "medium",
          "enum": [
            "low",
            "medium",
            "high"
          ],
          "title": "Risk Tier",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "label",
        "confidence",
        "reason_codes"
      ],
      "title": "Task",
      "type": "object"
    },
    "Usage": {
      "additionalProperties": false,
      "properties": {
        "cached_input_tokens": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cached Input Tokens"
        },
        "input_tokens": {
          "minimum": 0,
          "title": "Input Tokens",
          "type": "integer"
        },
        "output_tokens": {
          "minimum": 0,
          "title": "Output Tokens",
          "type": "integer"
        },
        "reasoning_tokens": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reasoning Tokens"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "source": {
          "enum": [
            "provider_reported",
            "locally_estimated"
          ],
          "title": "Source",
          "type": "string"
        },
        "tokenizer": {
          "title": "Tokenizer",
          "type": "string"
        }
      },
      "required": [
        "input_tokens",
        "output_tokens",
        "source",
        "tokenizer"
      ],
      "title": "Usage",
      "type": "object"
    },
    "Validation": {
      "additionalProperties": false,
      "properties": {
        "checks": {
          "items": {
            "$ref": "#/$defs/ValidationCheck"
          },
          "title": "Checks",
          "type": "array"
        },
        "passed": {
          "title": "Passed",
          "type": "boolean"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "validator_version": {
          "default": "baseline-validator-1",
          "title": "Validator Version",
          "type": "string"
        }
      },
      "required": [
        "passed",
        "checks"
      ],
      "title": "Validation",
      "type": "object"
    },
    "ValidationCheck": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "passed": {
          "title": "Passed",
          "type": "boolean"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "name",
        "passed"
      ],
      "title": "ValidationCheck",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "data": {
      "anyOf": [
        {
          "$ref": "#/$defs/Started"
        },
        {
          "$ref": "#/$defs/RetrievalRun"
        },
        {
          "$ref": "#/$defs/RouteDecision"
        },
        {
          "$ref": "#/$defs/GenerationAttempt"
        },
        {
          "$ref": "#/$defs/Interaction"
        },
        {
          "$ref": "#/$defs/Feedback"
        }
      ],
      "title": "Data"
    },
    "event_id": {
      "title": "Event Id",
      "type": "string"
    },
    "event_type": {
      "enum": [
        "interaction.started.v1",
        "retrieval.completed.v1",
        "route.decided.v1",
        "generation.completed.v1",
        "generation.failed.v1",
        "interaction.completed.v1",
        "feedback.recorded.v1"
      ],
      "title": "Event Type",
      "type": "string"
    },
    "occurred_at": {
      "format": "date-time",
      "title": "Occurred At",
      "type": "string"
    },
    "producer": {
      "const": "gateway",
      "default": "gateway",
      "title": "Producer",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "tenant_id": {
      "title": "Tenant Id",
      "type": "string"
    },
    "trace_id": {
      "title": "Trace Id",
      "type": "string"
    }
  },
  "required": [
    "event_type",
    "tenant_id",
    "trace_id",
    "data"
  ],
  "title": "Event",
  "type": "object"
}
