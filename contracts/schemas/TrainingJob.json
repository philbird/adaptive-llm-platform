{
  "$defs": {
    "AdapterConfig": {
      "properties": {
        "alpha": {
          "default": 16,
          "exclusiveMinimum": 0,
          "title": "Alpha",
          "type": "number"
        },
        "dropout": {
          "default": 0,
          "exclusiveMaximum": 1,
          "minimum": 0,
          "title": "Dropout",
          "type": "number"
        },
        "gradient_accumulation": {
          "default": 1,
          "minimum": 1,
          "title": "Gradient Accumulation",
          "type": "integer"
        },
        "learning_rate": {
          "default": 0.0002,
          "exclusiveMinimum": 0,
          "title": "Learning Rate",
          "type": "number"
        },
        "precision": {
          "default": "fp32",
          "enum": [
            "fp32",
            "fp16",
            "bf16"
          ],
          "title": "Precision",
          "type": "string"
        },
        "rank": {
          "default": 8,
          "minimum": 1,
          "title": "Rank",
          "type": "integer"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "target_modules": {
          "items": {
            "maxLength": 100,
            "minLength": 1,
            "pattern": "^[\\w.-]+$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Target Modules",
          "type": "array"
        }
      },
      "title": "AdapterConfig",
      "type": "object"
    },
    "ResourceUsage": {
      "properties": {
        "artifact_bytes": {
          "default": 0,
          "minimum": 0,
          "title": "Artifact Bytes",
          "type": "integer"
        },
        "cpu_seconds": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cpu Seconds"
        },
        "examples": {
          "default": 0,
          "minimum": 0,
          "title": "Examples",
          "type": "integer"
        },
        "peak_memory_bytes": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Peak Memory Bytes"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "steps": {
          "default": 0,
          "minimum": 0,
          "title": "Steps",
          "type": "integer"
        },
        "wall_seconds": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Wall Seconds"
        }
      },
      "title": "ResourceUsage",
      "type": "object"
    },
    "TrainingJobSpecification": {
      "properties": {
        "adapter_config": {
          "$ref": "#/$defs/AdapterConfig"
        },
        "base_model_id": {
          "default": "fake-foundation",
          "maxLength": 100,
          "minLength": 1,
          "pattern": "^[\\w.-]+$",
          "title": "Base Model Id",
          "type": "string"
        },
        "base_model_licence": {
          "default": "synthetic",
          "maxLength": 100,
          "minLength": 1,
          "pattern": "^[\\w.-]+$",
          "title": "Base Model Licence",
          "type": "string"
        },
        "base_model_revision": {
          "default": "fake-1",
          "maxLength": 100,
          "minLength": 1,
          "pattern": "^[\\w.-]+$",
          "title": "Base Model Revision",
          "type": "string"
        },
        "batch_size": {
          "default": 1,
          "minimum": 1,
          "title": "Batch Size",
          "type": "integer"
        },
        "chat_template_version": {
          "default": "fake-chat-1",
          "maxLength": 100,
          "minLength": 1,
          "pattern": "^[\\w.-]+$",
          "title": "Chat Template Version",
          "type": "string"
        },
        "checkpoint_every": {
          "default": 1,
          "minimum": 1,
          "title": "Checkpoint Every",
          "type": "integer"
        },
        "code_revision": {
          "default": "server",
          "title": "Code Revision",
          "type": "string"
        },
        "container_digest": {
          "default": "local",
          "title": "Container Digest",
          "type": "string"
        },
        "dataset_id": {
          "maxLength": 100,
          "minLength": 1,
          "pattern": "^[\\w.-]+$",
          "title": "Dataset Id",
          "type": "string"
        },
        "dataset_version": {
          "maxLength": 100,
          "minLength": 1,
          "pattern": "^[\\w.-]+$",
          "title": "Dataset Version",
          "type": "string"
        },
        "hardware_class": {
          "default": "cpu",
          "maxLength": 100,
          "minLength": 1,
          "pattern": "^[\\w.-]+$",
          "title": "Hardware Class",
          "type": "string"
        },
        "job_id": {
          "maxLength": 100,
          "minLength": 1,
          "pattern": "^[\\w.-]+$",
          "title": "Job Id",
          "type": "string"
        },
        "job_type": {
          "const": "adapter",
          "default": "adapter",
          "title": "Job Type",
          "type": "string"
        },
        "max_sequence_length": {
          "default": 256,
          "minimum": 2,
          "title": "Max Sequence Length",
          "type": "integer"
        },
        "registry_id": {
          "default": "synthetic-specialist",
          "maxLength": 100,
          "minLength": 1,
          "pattern": "^[\\w.-]+$",
          "title": "Registry Id",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "seed": {
          "default": 23,
          "minimum": 0,
          "title": "Seed",
          "type": "integer"
        },
        "steps": {
          "default": 2,
          "minimum": 1,
          "title": "Steps",
          "type": "integer"
        },
        "tokenizer_id": {
          "default": "fake-whitespace-v1",
          "maxLength": 100,
          "minLength": 1,
          "pattern": "^[\\w.-]+$",
          "title": "Tokenizer Id",
          "type": "string"
        }
      },
      "required": [
        "dataset_id",
        "dataset_version"
      ],
      "title": "TrainingJobSpecification",
      "type": "object"
    }
  },
  "properties": {
    "artifact_digest": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Artifact Digest"
    },
    "artifact_ref": {
      "anyOf": [
        {
          "maxLength": 512,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Artifact Ref"
    },
    "cancel_requested": {
      "default": false,
      "title": "Cancel Requested",
      "type": "boolean"
    },
    "checkpoint_refs": {
      "items": {
        "maxLength": 512,
        "minLength": 1,
        "type": "string"
      },
      "title": "Checkpoint Refs",
      "type": "array"
    },
    "completed_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Completed At"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "failure_code": {
      "anyOf": [
        {
          "maxLength": 100,
          "minLength": 1,
          "pattern": "^[\\w.-]+$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Failure Code"
    },
    "model_version": {
      "maxLength": 100,
      "minLength": 1,
      "pattern": "^[\\w.-]+$",
      "title": "Model Version",
      "type": "string"
    },
    "resource_usage": {
      "$ref": "#/$defs/ResourceUsage"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "specification": {
      "$ref": "#/$defs/TrainingJobSpecification"
    },
    "started_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Started At"
    },
    "state": {
      "default": "queued",
      "enum": [
        "queued",
        "running",
        "succeeded",
        "failed",
        "cancelled"
      ],
      "title": "State",
      "type": "string"
    },
    "trainer_architecture": {
      "default": "deterministic-fake-adapter-v1",
      "maxLength": 100,
      "minLength": 1,
      "pattern": "^[\\w.-]+$",
      "title": "Trainer Architecture",
      "type": "string"
    }
  },
  "required": [
    "specification"
  ],
  "title": "TrainingJob",
  "type": "object"
}
