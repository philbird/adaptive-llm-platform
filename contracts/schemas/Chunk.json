      "maxLength": 32000,
      "title": "Content",
      "type": "string"
    },
    "document_family": {
      "maxLength": 100,
      "minLength": 1,
      "pattern": "^[\\w.-]+$",
      "title": "Document Family",
      "type": "string"
    },
    "document_id": {
      "maxLength": 100,
      "minLength": 1,
      "pattern": "^[\\w.-]+$",
      "title": "Document Id",
      "type": "string"
    },
    "document_version": {
      "title": "Document Version",
      "type": "string"
    },
    "environment": {
      "const": "local",
      "default": "local",
      "title": "Environment",
      "type": "string"
    },
    "index_id": {
      "default": "support-kb",
      "maxLength": 100,
      "minLength": 1,
      "pattern": "^[\\w.-]+$",
