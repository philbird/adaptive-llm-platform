{
  "additionalProperties": false,
  "properties": {
    "request_id": {
      "maxLength": 100,
      "minLength": 1,
      "pattern": "^[\\w.-]+$",
      "title": "Request Id",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "score": {
      "maximum": 5,
      "minimum": 1,
      "title": "Score",
      "type": "integer"
    }
  },
  "required": [
    "request_id",
    "score"
  ],
  "title": "FeedbackInput",
  "type": "object"
}
