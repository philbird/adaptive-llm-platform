{
  "$defs": {
    "RequestParameters": {
      "properties": {
        "max_output_tokens": {
          "minimum": 1,
          "title": "Max Output Tokens",
          "type": "integer"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "seed": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Seed"
        },
        "temperature": {
          "anyOf": [
            {
              "maximum": 2,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Temperature"
        }
      },
      "required": [
        "max_output_tokens"
      ],
      "title": "RequestParameters",
      "type": "object"
    },
    "ToolCall": {
      "description": "Reserved for tool use. Arguments are never stored inline; only a hash and a reference.",
      "properties": {
        "allowed": {
          "title": "Allowed",
          "type": "boolean"
        },
        "arguments_hash": {
          "title": "Arguments Hash",
          "type": "string"
        },
        "arguments_ref": {
          "anyOf": [
            {
              "maxLength": 512,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Arguments Ref"
        },
        "result_ref": {
          "anyOf": [
            {
              "maxLength": 512,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Result Ref"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "tool_name": {
          "maxLength": 100,
          "minLength": 1,
          "pattern": "^[\\w.-]+$",
          "title": "Tool Name",
          "type": "string"
        }
      },
      "required": [
        "tool_name",
        "arguments_hash",
        "allowed"
      ],
      "title": "ToolCall",
      "type": "object"
    },
    "Usage": {
      "properties": {
        "cached_input_tokens": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cached Input Tokens"
        },
        "input_tokens": {
          "minimum": 0,
          "title": "Input Tokens",
          "type": "integer"
        },
        "output_tokens": {
          "minimum": 0,
          "title": "Output Tokens",
          "type": "integer"
        },
        "reasoning_tokens": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reasoning Tokens"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "source": {
          "enum": [
            "provider_reported",
            "locally_estimated"
          ],
          "title": "Source",
          "type": "string"
        },
        "tokenizer": {
          "title": "Tokenizer",
          "type": "string"
        }
      },
      "required": [
        "input_tokens",
        "output_tokens",
        "source",
        "tokenizer"
      ],
      "title": "Usage",
      "type": "object"
    },
    "Validation": {
      "properties": {
        "checks": {
          "items": {
            "$ref": "#/$defs/ValidationCheck"
          },
          "title": "Checks",
          "type": "array"
        },
        "passed": {
          "title": "Passed",
          "type": "boolean"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "validator_version": {
          "default": "baseline-validator-1",
          "title": "Validator Version",
          "type": "string"
        }
      },
      "required": [
        "passed",
        "checks"
      ],
      "title": "Validation",
      "type": "object"
    },
    "ValidationCheck": {
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "passed": {
          "title": "Passed",
          "type": "boolean"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "severity": {
          "default": "hard",
          "enum": [
            "hard",
            "advisory"
          ],
          "title": "Severity",
          "type": "string"
        },
        "version": {
          "default": "deterministic-1",
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "name",
        "passed"
      ],
      "title": "ValidationCheck",
      "type": "object"
    }
  },
  "properties": {
    "adapter_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Adapter Id"
    },
    "attempt_id": {
      "title": "Attempt Id",
      "type": "string"
    },
    "attempt_number": {
      "default": 1,
      "minimum": 0,
      "title": "Attempt Number",
      "type": "integer"
    },
    "deployment_id": {
      "title": "Deployment Id",
      "type": "string"
    },
    "error_code": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Error Code"
    },
    "estimated_cost_micros": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Estimated Cost Micros"
    },
    "fallback_reason": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Fallback Reason"
    },
    "finish_reason": {
      "enum": [
        "stop",
        "length",
        "error",
        "cancelled",
        "deadline_exceeded",
        "content_filter"
      ],
      "title": "Finish Reason",
      "type": "string"
    },
    "first_token_latency_ms": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "First Token Latency Ms"
    },
    "interaction_id": {
      "title": "Interaction Id",
      "type": "string"
    },
    "model_id": {
      "title": "Model Id",
      "type": "string"
    },
    "model_provider": {
      "title": "Model Provider",
      "type": "string"
    },
    "model_version": {
      "title": "Model Version",
      "type": "string"
    },
    "output_hash": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Output Hash"
    },
    "output_ref": {
      "anyOf": [
        {
          "maxLength": 512,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Output Ref"
    },
    "price_list_version": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Price List Version"
    },
    "request_parameters": {
      "anyOf": [
        {
          "$ref": "#/$defs/RequestParameters"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "shadow": {
      "default": false,
      "title": "Shadow",
      "type": "boolean"
    },
    "tool_calls": {
      "items": {
        "$ref": "#/$defs/ToolCall"
      },
      "title": "Tool Calls",
      "type": "array"
    },
    "total_latency_ms": {
      "title": "Total Latency Ms",
      "type": "number"
    },
    "usage": {
      "anyOf": [
        {
          "$ref": "#/$defs/Usage"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "validation": {
      "anyOf": [
        {
          "$ref": "#/$defs/Validation"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
    "interaction_id",
    "model_provider",
    "model_id",
    "model_version",
    "deployment_id",
    "total_latency_ms",
    "finish_reason"
  ],
  "title": "GenerationAttempt",
  "type": "object"
}
