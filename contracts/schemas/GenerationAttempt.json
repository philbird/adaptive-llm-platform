        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "validator_version": {
          "default": "baseline-validator-1",
          "title": "Validator Version",
          "type": "string"
        }
      },
      "required": [
        "passed",
        "checks"
