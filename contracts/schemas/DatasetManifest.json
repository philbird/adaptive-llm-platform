{
  "$defs": {
    "DatasetApproval": {
      "properties": {
        "actor": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Actor"
        },
        "at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "At"
        },
        "mac": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Mac"
        },
        "reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reason"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "status": {
          "default": "pending",
          "enum": [
            "pending",
            "approved",
            "rejected"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "title": "DatasetApproval",
      "type": "object"
    },
    "DatasetQualitySummary": {
      "properties": {
        "accepted_rate": {
          "title": "Accepted Rate",
          "type": "number"
        },
        "considered": {
          "title": "Considered",
          "type": "integer"
        },
        "duplicate_rate": {
          "title": "Duplicate Rate",
          "type": "number"
        },
        "exclusions": {
          "additionalProperties": {
            "type": "integer"
          },
          "title": "Exclusions",
          "type": "object"
        },
        "label_mix": {
          "additionalProperties": {
            "type": "integer"
          },
          "title": "Label Mix",
          "type": "object"
        },
        "languages": {
          "additionalProperties": {
            "type": "integer"
          },
          "title": "Languages",
          "type": "object"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "considered",
        "accepted_rate",
        "duplicate_rate",
        "exclusions",
        "label_mix",
        "languages"
      ],
      "title": "DatasetQualitySummary",
      "type": "object"
    },
    "DatasetSpecification": {
      "properties": {
        "dataset_id": {
          "maxLength": 100,
          "minLength": 1,
          "pattern": "^[\\w.-]+$",
          "title": "Dataset Id",
          "type": "string"
        },
        "eligibility_policy_version": {
          "maxLength": 100,
          "minLength": 1,
          "pattern": "^[\\w.-]+$",
          "title": "Eligibility Policy Version",
          "type": "string"
        },
        "grouping_keys": {
          "items": {
            "enum": [
              "document_family",
              "subject_id_pseudonymous"
            ],
            "type": "string"
          },
          "title": "Grouping Keys",
          "type": "array"
        },
        "minimum_examples": {
          "default": 1,
          "minimum": 1,
          "title": "Minimum Examples",
          "type": "integer"
        },
        "near_duplicate_threshold": {
          "default": 0.8,
          "maximum": 1,
          "minimum": 0,
          "title": "Near Duplicate Threshold",
          "type": "number"
        },
        "purpose": {
          "default": "adapter_training",
          "enum": [
            "adapter_training",
            "distillation",
            "router_training",
            "evaluation"
          ],
          "title": "Purpose",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "seed": {
          "default": 0,
          "minimum": 0,
          "title": "Seed",
          "type": "integer"
        },
        "source_dataset_id": {
          "anyOf": [
            {
              "maxLength": 100,
              "minLength": 1,
              "pattern": "^[\\w.-]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Dataset Id"
        },
        "source_dataset_version": {
          "anyOf": [
            {
              "maxLength": 100,
              "minLength": 1,
              "pattern": "^[\\w.-]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Dataset Version"
        },
        "source_window": {
          "$ref": "#/$defs/SourceWindow"
        },
        "split_strategy": {
          "const": "subject_and_document_family",
          "default": "subject_and_document_family",
          "title": "Split Strategy",
          "type": "string"
        },
        "target_preference_order": {
          "items": {
            "enum": [
              "correction",
              "positive_resolution",
              "production_output"
            ],
            "type": "string"
          },
          "maxItems": 3,
          "minItems": 1,
          "title": "Target Preference Order",
          "type": "array"
        },
        "tenant_ids": {
          "items": {
            "maxLength": 100,
            "minLength": 1,
            "pattern": "^[\\w.-]+$",
            "type": "string"
          },
          "maxItems": 100,
          "minItems": 1,
          "title": "Tenant Ids",
          "type": "array"
        },
        "time_split": {
          "anyOf": [
            {
              "$ref": "#/$defs/TimeSplit"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "dataset_id",
        "tenant_ids",
        "source_window",
        "eligibility_policy_version"
      ],
      "title": "DatasetSpecification",
      "type": "object"
    },
    "SourceWindow": {
      "properties": {
        "end": {
          "format": "date-time",
          "title": "End",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "start": {
          "format": "date-time",
          "title": "Start",
          "type": "string"
        }
      },
      "required": [
        "start",
        "end"
      ],
      "title": "SourceWindow",
      "type": "object"
    },
    "TimeSplit": {
      "properties": {
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "train_end": {
          "format": "date-time",
          "title": "Train End",
          "type": "string"
        },
        "validation_end": {
          "format": "date-time",
          "title": "Validation End",
          "type": "string"
        }
      },
      "required": [
        "train_end",
        "validation_end"
      ],
      "title": "TimeSplit",
      "type": "object"
    }
  },
  "properties": {
    "approval": {
      "$ref": "#/$defs/DatasetApproval"
    },
    "content_digest": {
      "title": "Content Digest",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "dataset_id": {
      "maxLength": 100,
      "minLength": 1,
      "pattern": "^[\\w.-]+$",
      "title": "Dataset Id",
      "type": "string"
    },
    "deletions_applied_through": {
      "format": "date-time",
      "title": "Deletions Applied Through",
      "type": "string"
    },
    "eligibility_policy_version": {
      "title": "Eligibility Policy Version",
      "type": "string"
    },
    "examples": {
      "additionalProperties": {
        "type": "integer"
      },
      "propertyNames": {
        "enum": [
          "train",
          "validation",
          "test"
        ]
      },
      "title": "Examples",
      "type": "object"
    },
    "licence_policy_version": {
      "default": "synthetic-internal-approved-1",
      "title": "Licence Policy Version",
      "type": "string"
    },
    "purpose": {
      "enum": [
        "adapter_training",
        "distillation",
        "router_training",
        "evaluation"
      ],
      "title": "Purpose",
      "type": "string"
    },
    "quality_summary": {
      "$ref": "#/$defs/DatasetQualitySummary"
    },
    "redaction_version": {
      "title": "Redaction Version",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "source_window": {
      "$ref": "#/$defs/SourceWindow"
    },
    "specification": {
      "$ref": "#/$defs/DatasetSpecification"
    },
    "split_strategy": {
      "const": "subject_and_document_family",
      "title": "Split Strategy",
      "type": "string"
    },
    "tenant_ids": {
      "items": {
        "maxLength": 100,
        "minLength": 1,
        "pattern": "^[\\w.-]+$",
        "type": "string"
      },
      "title": "Tenant Ids",
      "type": "array"
    },
    "transformation_code_revision": {
      "title": "Transformation Code Revision",
      "type": "string"
    },
    "version": {
      "maxLength": 100,
      "minLength": 1,
      "pattern": "^[\\w.-]+$",
      "title": "Version",
      "type": "string"
    }
  },
  "required": [
    "dataset_id",
    "version",
    "purpose",
    "tenant_ids",
    "source_window",
    "eligibility_policy_version",
    "transformation_code_revision",
    "redaction_version",
    "examples",
    "split_strategy",
    "content_digest",
    "deletions_applied_through",
    "quality_summary",
    "specification"
  ],
  "title": "DatasetManifest",
  "type": "object"
}
