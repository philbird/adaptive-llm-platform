{
  "$defs": {
    "DatasetApproval": {
      "properties": {
        "actor": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Actor"
        },
        "approval_mac_version": {
          "default": "1",
          "enum": [
            "1",
            "2"
          ],
          "title": "Approval Mac Version",
          "type": "string"
        },
        "at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "At"
        },
        "mac": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Mac"
        },
        "reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reason"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "signature": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Signature"
        },
        "signature_key_id": {
          "anyOf": [
            {
              "maxLength": 100,
              "minLength": 1,
              "pattern": "^[\\w.-]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Signature Key Id"
        },
        "signature_version": {
          "anyOf": [
            {
              "const": "ed25519-v1",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Signature Version"
        },
        "status": {
          "default": "pending",
          "enum": [
            "pending",
            "approved",
            "rejected"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "title": "DatasetApproval",
      "type": "object"
    },
    "DatasetQualitySummary": {
      "properties": {
        "accepted_rate": {
          "title": "Accepted Rate",
          "type": "number"
        },
        "considered": {
          "title": "Considered",
          "type": "integer"
        },
        "duplicate_rate": {
          "title": "Duplicate Rate",
          "type": "number"
        },
        "exclusions": {
          "additionalProperties": {
            "type": "integer"
          },
          "title": "Exclusions",
          "type": "object"
        },
        "label_mix": {
          "additionalProperties": {
            "type": "integer"
          },
          "title": "Label Mix",
          "type": "object"
        },
        "languages": {
          "additionalProperties": {
            "type": "integer"
          },
          "title": "Languages",
          "type": "object"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "considered",
        "accepted_rate",
        "duplicate_rate",
        "exclusions",
        "label_mix",
        "languages"
      ],
      "title": "DatasetQualitySummary",
      "type": "object"
    },
    "DatasetSpecification": {
      "properties": {
        "dataset_id": {
          "maxLength": 100,
          "minLength": 1,
          "pattern": "^[\\w.-]+$",
          "title": "Dataset Id",
          "type": "string"
        },
        "eligibility_policy_version": {
          "maxLength": 100,
          "minLength": 1,
          "pattern": "^[\\w.-]+$",
          "title": "Eligibility Policy Version",
          "type": "string"
        },
        "fixture_set": {
          "default": "synthetic",
          "maxLength": 100,
          "minLength": 1,
          "pattern": "^[\\w.-]+$",
          "title": "Fixture Set",
          "type": "string"
        },
        "general_safety_fraction": {
          "default": 0.2,
          "maximum": 0.8,
          "minimum": 0,
          "title": "General Safety Fraction",
          "type": "number"
        },
        "grouping_keys": {
          "items": {
            "enum": [
              "document_family",
              "subject_id_pseudonymous"
            ],
            "type": "string"
          },
          "title": "Grouping Keys",
          "type": "array"
        },
        "minimum_examples": {
          "default": 1,
          "minimum": 1,
          "title": "Minimum Examples",
          "type": "integer"
        },
        "near_duplicate_threshold": {
          "default": 0.8,
          "maximum": 1,
          "minimum": 0,
          "title": "Near Duplicate Threshold",
          "type": "number"
        },
        "purpose": {
          "default": "adapter_training",
          "enum": [
            "adapter_training",
            "distillation",
            "router_training",
            "evaluation"
          ],
          "title": "Purpose",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "seed": {
          "default": 0,
          "minimum": 0,
          "title": "Seed",
          "type": "integer"
        },
        "soft_targets": {
          "default": false,
          "title": "Soft Targets",
          "type": "boolean"
        },
        "source_dataset_id": {
          "anyOf": [
            {
              "maxLength": 100,
              "minLength": 1,
              "pattern": "^[\\w.-]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Dataset Id"
        },
        "source_dataset_version": {
          "anyOf": [
            {
              "maxLength": 100,
              "minLength": 1,
              "pattern": "^[\\w.-]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Dataset Version"
        },
        "source_window": {
          "$ref": "#/$defs/SourceWindow"
        },
        "split_strategy": {
          "const": "subject_and_document_family",
          "default": "subject_and_document_family",
          "title": "Split Strategy",
          "type": "string"
        },
        "target_preference_order": {
          "items": {
            "enum": [
              "correction",
              "positive_resolution",
              "production_output"
            ],
            "type": "string"
          },
          "maxItems": 3,
          "minItems": 1,
          "title": "Target Preference Order",
          "type": "array"
        },
        "teacher_deployment_id": {
          "anyOf": [
            {
              "maxLength": 100,
              "minLength": 1,
              "pattern": "^[\\w.-]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Teacher Deployment Id"
        },
        "teacher_max_output_tokens": {
          "default": 256,
          "maximum": 2048,
          "minimum": 1,
          "title": "Teacher Max Output Tokens",
          "type": "integer"
        },
        "teacher_minimum_score": {
          "default": 0.9,
          "maximum": 1,
          "minimum": 0,
          "title": "Teacher Minimum Score",
          "type": "number"
        },
        "tenant_ids": {
          "items": {
            "maxLength": 100,
            "minLength": 1,
            "pattern": "^[\\w.-]+$",
            "type": "string"
          },
          "maxItems": 100,
          "minItems": 1,
          "title": "Tenant Ids",
          "type": "array"
        },
        "time_split": {
          "anyOf": [
            {
              "$ref": "#/$defs/TimeSplit"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "dataset_id",
        "tenant_ids",
        "source_window",
        "eligibility_policy_version"
      ],
      "title": "DatasetSpecification",
      "type": "object"
    },
    "DistillationLineage": {
      "properties": {
        "chat_template_version": {
          "anyOf": [
            {
              "maxLength": 100,
              "minLength": 1,
              "pattern": "^[\\w.-]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Chat Template Version"
        },
        "generation_parameters": {
          "patternProperties": {
            "^[\\w.-]+$": {
              "anyOf": [
                {
                  "type": "integer"
                },
                {
                  "type": "boolean"
                }
              ]
            }
          },
          "propertyNames": {
            "maxLength": 100,
            "minLength": 1
          },
          "title": "Generation Parameters",
          "type": "object"
        },
        "judge_version": {
          "maxLength": 100,
          "minLength": 1,
          "pattern": "^[\\w.-]+$",
          "title": "Judge Version",
          "type": "string"
        },
        "minimum_score": {
          "title": "Minimum Score",
          "type": "number"
        },
        "mix_content_digest": {
          "title": "Mix Content Digest",
          "type": "string"
        },
        "mix_counts": {
          "patternProperties": {
            "^[\\w.-]+$": {
              "type": "integer"
            }
          },
          "propertyNames": {
            "maxLength": 100,
            "minLength": 1
          },
          "title": "Mix Counts",
          "type": "object"
        },
        "requested_mix_fraction": {
          "title": "Requested Mix Fraction",
          "type": "number"
        },
        "rubric_version": {
          "maxLength": 100,
          "minLength": 1,
          "pattern": "^[\\w.-]+$",
          "title": "Rubric Version",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "soft_target_files": {
          "items": {
            "$ref": "#/$defs/SoftTargetFile"
          },
          "title": "Soft Target Files",
          "type": "array"
        },
        "source_content_digest": {
          "title": "Source Content Digest",
          "type": "string"
        },
        "source_dataset_id": {
          "maxLength": 100,
          "minLength": 1,
          "pattern": "^[\\w.-]+$",
          "title": "Source Dataset Id",
          "type": "string"
        },
        "source_dataset_version": {
          "maxLength": 100,
          "minLength": 1,
          "pattern": "^[\\w.-]+$",
          "title": "Source Dataset Version",
          "type": "string"
        },
        "teacher_artifact_digest": {
          "title": "Teacher Artifact Digest",
          "type": "string"
        },
        "teacher_deployment_id": {
          "maxLength": 100,
          "minLength": 1,
          "pattern": "^[\\w.-]+$",
          "title": "Teacher Deployment Id",
          "type": "string"
        },
        "teacher_parameter_count": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Teacher Parameter Count"
        },
        "teacher_version": {
          "maxLength": 100,
          "minLength": 1,
          "pattern": "^[\\w.-]+$",
          "title": "Teacher Version",
          "type": "string"
        },
        "tokenizer_id": {
          "anyOf": [
            {
              "maxLength": 100,
              "minLength": 1,
              "pattern": "^[\\w.-]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tokenizer Id"
        }
      },
      "required": [
        "source_dataset_id",
        "source_dataset_version",
        "source_content_digest",
        "teacher_deployment_id",
        "teacher_version",
        "teacher_artifact_digest",
        "generation_parameters",
        "judge_version",
        "rubric_version",
        "minimum_score",
        "requested_mix_fraction",
        "mix_counts",
        "mix_content_digest"
      ],
      "title": "DistillationLineage",
      "type": "object"
    },
    "SoftTargetFile": {
      "properties": {
        "example_hash": {
          "maxLength": 100,
          "minLength": 1,
          "pattern": "^[\\w.-]+$",
          "title": "Example Hash",
          "type": "string"
        },
        "key_version": {
          "maxLength": 100,
          "minLength": 1,
          "pattern": "^[\\w.-]+$",
          "title": "Key Version",
          "type": "string"
        },
        "plaintext_hash": {
          "title": "Plaintext Hash",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "tenant_id": {
          "maxLength": 100,
          "minLength": 1,
          "pattern": "^[\\w.-]+$",
          "title": "Tenant Id",
          "type": "string"
        }
      },
      "required": [
        "tenant_id",
        "example_hash",
        "plaintext_hash",
        "key_version"
      ],
      "title": "SoftTargetFile",
      "type": "object"
    },
    "SourceWindow": {
      "properties": {
        "end": {
          "format": "date-time",
          "title": "End",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "start": {
          "format": "date-time",
          "title": "Start",
          "type": "string"
        }
      },
      "required": [
        "start",
        "end"
      ],
      "title": "SourceWindow",
      "type": "object"
    },
    "TimeSplit": {
      "properties": {
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "train_end": {
          "format": "date-time",
          "title": "Train End",
          "type": "string"
        },
        "validation_end": {
          "format": "date-time",
          "title": "Validation End",
          "type": "string"
        }
      },
      "required": [
        "train_end",
        "validation_end"
      ],
      "title": "TimeSplit",
      "type": "object"
    }
  },
  "properties": {
    "approval": {
      "$ref": "#/$defs/DatasetApproval"
    },
    "content_digest": {
      "title": "Content Digest",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "dataset_id": {
      "maxLength": 100,
      "minLength": 1,
      "pattern": "^[\\w.-]+$",
      "title": "Dataset Id",
      "type": "string"
    },
    "deletions_applied_through": {
      "format": "date-time",
      "title": "Deletions Applied Through",
      "type": "string"
    },
    "distillation": {
      "anyOf": [
        {
          "$ref": "#/$defs/DistillationLineage"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "eligibility_policy_version": {
      "title": "Eligibility Policy Version",
      "type": "string"
    },
    "examples": {
      "additionalProperties": {
        "type": "integer"
      },
      "propertyNames": {
        "enum": [
          "train",
          "validation",
          "test"
        ]
      },
      "title": "Examples",
      "type": "object"
    },
    "licence_policy_version": {
      "default": "synthetic-internal-approved-1",
      "title": "Licence Policy Version",
      "type": "string"
    },
    "purpose": {
      "enum": [
        "adapter_training",
        "distillation",
        "router_training",
        "evaluation"
      ],
      "title": "Purpose",
      "type": "string"
    },
    "quality_summary": {
      "$ref": "#/$defs/DatasetQualitySummary"
    },
    "redaction_version": {
      "title": "Redaction Version",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "signature": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Signature"
    },
    "signature_key_id": {
      "anyOf": [
        {
          "maxLength": 100,
          "minLength": 1,
          "pattern": "^[\\w.-]+$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Signature Key Id"
    },
    "signature_version": {
      "anyOf": [
        {
          "const": "ed25519-v1",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Signature Version"
    },
    "source_window": {
      "$ref": "#/$defs/SourceWindow"
    },
    "specification": {
      "$ref": "#/$defs/DatasetSpecification"
    },
    "split_strategy": {
      "const": "subject_and_document_family",
      "title": "Split Strategy",
      "type": "string"
    },
    "tenant_ids": {
      "items": {
        "maxLength": 100,
        "minLength": 1,
        "pattern": "^[\\w.-]+$",
        "type": "string"
      },
      "title": "Tenant Ids",
      "type": "array"
    },
    "transformation_code_revision": {
      "title": "Transformation Code Revision",
      "type": "string"
    },
    "version": {
      "maxLength": 100,
      "minLength": 1,
      "pattern": "^[\\w.-]+$",
      "title": "Version",
      "type": "string"
    }
  },
  "required": [
    "dataset_id",
    "version",
    "purpose",
    "tenant_ids",
    "source_window",
    "eligibility_policy_version",
    "transformation_code_revision",
    "redaction_version",
    "examples",
    "split_strategy",
    "content_digest",
    "deletions_applied_through",
    "quality_summary",
    "specification"
  ],
  "title": "DatasetManifest",
  "type": "object"
}
