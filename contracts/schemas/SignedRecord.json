{
  "properties": {
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "signature": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Signature"
    },
    "signature_key_id": {
      "anyOf": [
        {
          "maxLength": 100,
          "minLength": 1,
          "pattern": "^[\\w.-]+$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Signature Key Id"
    },
    "signature_version": {
      "anyOf": [
        {
          "const": "ed25519-v1",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Signature Version"
    }
  },
  "title": "SignedRecord",
  "type": "object"
}
