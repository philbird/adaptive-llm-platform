{
  "properties": {
    "actor": {
      "anyOf": [
        {
          "maxLength": 100,
          "minLength": 1,
          "pattern": "^[\\w.-]+$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Actor"
    },
    "evaluation_id": {
      "anyOf": [
        {
          "maxLength": 100,
          "minLength": 1,
          "pattern": "^[\\w.-]+$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Evaluation Id"
    },
    "model_version": {
      "maxLength": 100,
      "minLength": 1,
      "pattern": "^[\\w.-]+$",
      "title": "Model Version",
      "type": "string"
    },
    "reason": {
      "maxLength": 2000,
      "minLength": 1,
      "title": "Reason",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "target_state": {
      "enum": [
        "candidate",
        "evaluating",
        "approved",
        "shadow",
        "canary",
        "production",
        "deprecated",
        "revoked"
      ],
      "title": "Target State",
      "type": "string"
    }
  },
  "required": [
    "reason",
    "model_version",
    "target_state"
  ],
  "title": "PromotionRequest",
  "type": "object"
}
