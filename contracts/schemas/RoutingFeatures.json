{
  "additionalProperties": false,
  "properties": {
    "chunk_count": {
      "default": 0,
      "minimum": 0,
      "title": "Chunk Count",
      "type": "integer"
    },
    "context_supplied": {
      "default": false,
      "title": "Context Supplied",
      "type": "boolean"
    },
    "index_id": {
      "anyOf": [
        {
          "maxLength": 100,
          "minLength": 1,
          "pattern": "^[\\w.-]+$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Index Id"
    },
    "input_tokens": {
      "minimum": 0,
      "title": "Input Tokens",
      "type": "integer"
    },
    "language": {
      "default": "en",
      "maxLength": 100,
      "minLength": 1,
      "pattern": "^[\\w.-]+$",
      "title": "Language",
      "type": "string"
    },
    "risk_tier": {
      "default": "medium",
      "enum": [
        "low",
        "medium",
        "high"
      ],
      "title": "Risk Tier",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "task": {
      "maxLength": 100,
      "minLength": 1,
      "pattern": "^[\\w.-]+$",
      "title": "Task",
      "type": "string"
    },
    "top_score": {
      "default": 0,
      "minimum": 0,
      "title": "Top Score",
      "type": "number"
    }
  },
  "required": [
    "task",
    "input_tokens"
  ],
  "title": "RoutingFeatures",
  "type": "object"
}
