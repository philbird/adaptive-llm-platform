{
  "properties": {
    "actor": {
      "maxLength": 100,
      "minLength": 1,
      "pattern": "^[\\w.-]+$",
      "title": "Actor",
      "type": "string"
    },
    "at": {
      "format": "date-time",
      "title": "At",
      "type": "string"
    },
    "evaluation_id": {
      "anyOf": [
        {
          "maxLength": 100,
          "minLength": 1,
          "pattern": "^[\\w.-]+$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Evaluation Id"
    },
    "from_state": {
      "anyOf": [
        {
          "enum": [
            "candidate",
            "evaluating",
            "approved",
            "shadow",
            "canary",
            "production",
            "deprecated",
            "revoked"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "From State"
    },
    "reason": {
      "title": "Reason",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "to_state": {
      "enum": [
        "candidate",
        "evaluating",
        "approved",
        "shadow",
        "canary",
        "production",
        "deprecated",
        "revoked"
      ],
      "title": "To State",
      "type": "string"
    }
  },
  "required": [
    "from_state",
    "to_state",
    "actor",
    "reason"
  ],
  "title": "LifecycleTransition",
  "type": "object"
}
