{
  "$defs": {
    "InputSummary": {
      "properties": {
        "content_hash": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Content Hash"
        },
        "hash_scheme": {
          "default": "hmac-sha256",
          "enum": [
            "sha256",
            "hmac-sha256"
          ],
          "title": "Hash Scheme",
          "type": "string"
        },
        "messages_ref": {
          "anyOf": [
            {
              "maxLength": 512,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Messages Ref"
        },
        "modality": {
          "items": {
            "const": "text",
            "type": "string"
          },
          "title": "Modality",
          "type": "array"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "token_count": {
          "minimum": 0,
          "title": "Token Count",
          "type": "integer"
        },
        "tokenizer": {
          "title": "Tokenizer",
          "type": "string"
        }
      },
      "required": [
        "content_hash",
        "token_count",
        "tokenizer"
      ],
      "title": "InputSummary",
      "type": "object"
    },
    "PolicyDecision": {
      "properties": {
        "content_logging_allowed": {
          "default": false,
          "title": "Content Logging Allowed",
          "type": "boolean"
        },
        "evaluation_allowed": {
          "default": false,
          "title": "Evaluation Allowed",
          "type": "boolean"
        },
        "human_review_allowed": {
          "default": false,
          "title": "Human Review Allowed",
          "type": "boolean"
        },
        "persistence_redaction_counts": {
          "additionalProperties": {
            "type": "integer"
          },
          "title": "Persistence Redaction Counts",
          "type": "object"
        },
        "persistence_redaction_version": {
          "default": "persistence-regex-local-1",
          "title": "Persistence Redaction Version",
          "type": "string"
        },
        "policy_version": {
          "title": "Policy Version",
          "type": "string"
        },
        "processing_allowed": {
          "default": true,
          "title": "Processing Allowed",
          "type": "boolean"
        },
        "processing_redaction_counts": {
          "additionalProperties": {
            "type": "integer"
          },
          "title": "Processing Redaction Counts",
          "type": "object"
        },
        "processing_redaction_version": {
          "default": "processing-regex-local-1",
          "title": "Processing Redaction Version",
          "type": "string"
        },
        "residency": {
          "default": "local",
          "maxLength": 32,
          "minLength": 1,
          "pattern": "^[a-z0-9-]+$",
          "title": "Residency",
          "type": "string"
        },
        "retention_seconds": {
          "minimum": 1,
          "title": "Retention Seconds",
          "type": "integer"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "training_allowed": {
          "default": false,
          "title": "Training Allowed",
          "type": "boolean"
        }
      },
      "required": [
        "policy_version",
        "retention_seconds"
      ],
      "title": "PolicyDecision",
      "type": "object"
    },
    "Task": {
      "properties": {
        "classifier_version": {
          "default": "rules-1",
          "title": "Classifier Version",
          "type": "string"
        },
        "confidence": {
          "maximum": 1,
          "minimum": 0,
          "title": "Confidence",
          "type": "number"
        },
        "label": {
          "title": "Label",
          "type": "string"
        },
        "language": {
          "default": "en",
          "title": "Language",
          "type": "string"
        },
        "reason_codes": {
          "items": {
            "type": "string"
          },
          "title": "Reason Codes",
          "type": "array"
        },
        "risk_tier": {
          "default": "medium",
          "enum": [
            "low",
            "medium",
            "high"
          ],
          "title": "Risk Tier",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "label",
        "confidence",
        "reason_codes"
      ],
      "title": "Task",
      "type": "object"
    }
  },
  "properties": {
    "application_id": {
      "title": "Application Id",
      "type": "string"
    },
    "completed_at": {
      "format": "date-time",
      "title": "Completed At",
      "type": "string"
    },
    "environment": {
      "enum": [
        "local",
        "development",
        "staging",
        "production"
      ],
      "title": "Environment",
      "type": "string"
    },
    "error_code": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Error Code"
    },
    "feedback_ids": {
      "items": {
        "type": "string"
      },
      "title": "Feedback Ids",
      "type": "array"
    },
    "final_attempt_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Final Attempt Id"
    },
    "generation_attempt_ids": {
      "items": {
        "type": "string"
      },
      "title": "Generation Attempt Ids",
      "type": "array"
    },
    "input": {
      "$ref": "#/$defs/InputSummary"
    },
    "interaction_id": {
      "title": "Interaction Id",
      "type": "string"
    },
    "parent_interaction_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Parent Interaction Id"
    },
    "policy": {
      "$ref": "#/$defs/PolicyDecision"
    },
    "request_id": {
      "title": "Request Id",
      "type": "string"
    },
    "retrieval_run_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Retrieval Run Id"
    },
    "route_decision_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Route Decision Id"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "started_at": {
      "format": "date-time",
      "title": "Started At",
      "type": "string"
    },
    "status": {
      "enum": [
        "completed",
        "failed"
      ],
      "title": "Status",
      "type": "string"
    },
    "subject_id_pseudonymous": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Subject Id Pseudonymous"
    },
    "task": {
      "$ref": "#/$defs/Task"
    },
    "tenant_id": {
      "title": "Tenant Id",
      "type": "string"
    },
    "trace_id": {
      "title": "Trace Id",
      "type": "string"
    }
  },
  "required": [
    "interaction_id",
    "trace_id",
    "request_id",
    "tenant_id",
    "subject_id_pseudonymous",
    "application_id",
    "environment",
    "started_at",
    "completed_at",
    "task",
    "policy",
    "input",
    "retrieval_run_id",
    "route_decision_id",
    "generation_attempt_ids",
    "final_attempt_id",
    "status"
  ],
  "title": "Interaction",
  "type": "object"
}
